# The raw Anki-export dump this project was seeded from: 133 MB, third-party,
# and not needed to build. content/sources/dump_*.json holds everything the
# build actually uses, so `python content/build_content.py` still works without
# it. See README for where it came from.
jlpt-N3-tiered/

# Cloudflare Worker. .wrangler/ caches the account id and account name (which
# contains an email address) wherever wrangler happens to be run from, so match
# it at any depth rather than only under worker/.
**/.wrangler/
worker/node_modules/
.dev.vars

# Real deploy config: holds the account-specific KV namespace id. The committed
# worker/wrangler.toml carries a placeholder instead.
worker/wrangler.local.toml

# Per-machine tool config. .claude/launch.json is shared on purpose; the
# local settings file is not.
.claude/settings.local.json

node_modules/
__pycache__/
*.pyc
.DS_Store
Thumbs.db
